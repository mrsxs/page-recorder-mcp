{
  "name": "page-recorder-mcp",
  "version": "1.4.0",
  "description": "Record clicks and the fetch/XHR APIs behind them in your logged-in Chrome (including cross-origin iframes), then let AI tools replay them or call the APIs directly through MCP / HTTP. Zero dependencies. 录制页面操作和接口（含跨域 iframe），让 Claude Code、Accio 等 AI 工具通过 MCP / HTTP 在你已登录的浏览器里回放，或直接调用接口。",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "recorder",
    "browser-automation",
    "api",
    "accio",
    "claude"
  ],
  "homepage": "https://github.com/mrsxs/page-recorder-mcp#readme",
  "bugs": "https://github.com/mrsxs/page-recorder-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsxs/page-recorder-mcp.git"
  },
  "license": "MIT",
  "bin": {
    "page-recorder-mcp": "bridge/server.js"
  },
  "files": [
    "bridge/server.js",
    "manifest.json",
    "background.js",
    "content/",
    "inject/",
    "lib/",
    "popup/",
    "icons/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bridge/server.js",
    "mcp": "node bridge/server.js --stdio",
    "test": "node --test test/smoke.test.mjs test/result.test.mjs test/tools.test.mjs"
  }
}
